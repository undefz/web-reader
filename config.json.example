{
  "telegram": {
    "api_id": 12345,
    "api_hash": "your_api_hash_here",
    "session_file": "~/.config/web.session",
    "phone": "+1234567890"
  },
  "rss": [
    "https://example.com/feed.xml"
  ],
  "hacker_news": {
    "enabled": true,
    "limit": 30
  },
  "state_file": "~/.config/web.state.json",
  "filter": {
    "min_negative_reactions": 10,
    "negative_emojis": ["🤡", "💩"]
  }
}
